def desconto(de, por):
    if de > por and de > 0:
        return int(round((1 - (por / de)) * 100))
    return 0

def brl(v):
    return ("%.2f" % v).replace(".", ",")

def card(p, selo, idx, marca_ess=False):
    d = desconto(p["de"], p["pc"])
    tem_vs = "vs" in p and len(p.get("vs", [])) > 1
    cls_ess = " card-ess" if marca_ess else ""
    badge = ("<span class='badge-desc'>-" + str(d) + "% OFF</span>") if d > 0 else ""
    selo_html = ("<span class='selo'>" + selo + "</span>") if selo else ""
    de_html = ("<div class='preco-de'>De R$ " + brl(p["de"]) + "</div>") if d > 0 else ""
    if p["e"] <= 10:
        est = "<div class='estoque'>Apenas " + str(int(p["e"])) + " unid.</div>"
    else:
        est = "<div class='estoque ok'>Disponivel</div>"

    if tem_vs:
        opts = ""
        for i, v in enumerate(p["vs"]):
            chk = "checked" if i == 0 else ""
            opts += ("<input type='radio' name='var" + str(idx) + "' id='v" + str(idx) + "_" + str(i) + "' value='" + v["ean"] + "' data-nome='" + v["v"] + "' data-preco='" + brl(v["pc"]) + "' data-est='" + str(int(v["e"])) + "' " + chk + " onchange='trocaVar(" + str(idx) + ")'>"
