@app.route("/")
def index():
    aba = request.args.get("aba", "").strip()
    q = request.args.get("q", "").strip().lower()
    if aba or q:
        lista = [p for p in CATALOGO if (not aba or p["c"] == aba)]
        if q:
            lista = [p for p in lista if q in p["n"].lower() or q in p["f"].lower()]
        conteudo = ("<div class='meta'>" + str(len(lista)) + " produtos encontrados</div>"
                    "<div class='grid'>" + render_lista(lista, "") + "</div>")
        return PAGINA.replace("__PILLS__", pills_html(aba)).replace("__CONTEUDO__", conteudo).replace("__Q__", request.args.get("q", ""))
    return home()

def pills_html(ativo):
    p = "<a class='pill " + ("on" if not ativo else "") + "' href='/'>Inicio</a>"
