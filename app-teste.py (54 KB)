def desconto(de, por):
    if de > por and de > 0:
        return int(round((1 - (por / de)) * 100))
    return 0

def brl(v):
    return ("%.2f" % v).replace(".", ",")

def card(p, idx):
    d = desconto(p["de"], p["pc"])
    tem_vs = "vs" in p and len(p.get("vs", [])) > 1
    badge = "<span class='bd'>-" + str(d) + "% OFF</span>" if d > 0 else ""
    de_html = "<div class='pde'>De R$ " + brl(p["de"]) + "</div>" if d > 0 else ""
    ean_pad = p.get("ean", "")
    if tem_vs:
        ean_pad = p["vs"][0]["ean"]
    opts = ""
    if tem_vs:
        for i, v in enumerate(p["vs"]):
            chk = "checked" if i == 0 else ""
            nm = v["v"].replace("'", "")
            opts = opts + "<input type='radio' name='v" + str(idx) + "' id='q" + str(idx) + "_" + str(i) + "' value='" + v["ean"] + "' data-nm='" + nm + "' data-pc='" + brl(v["pc"]) + "' " + chk + " onchange='mudaOp(" + str(idx) + ")'><label class='op' for='q" + str(idx) + "_" + str(i) + "'>" + v["v"] + "</label>"
    nm_pad = p["n"].replace("'", "")
    return ("<article class='card' data-i='" + str(idx) + "'>"
        "<div class='ctop'>" + badge + "</div>"
        "<div class='imgb'><img class='fot' src='" + CDN_IMG + ean_pad + "' alt='" + nm_pad + "' loading='lazy'></div>"
        "<div class='cb'>"
        "<h3 class='nm'>" + p["n"] + "</h3>"
        "<div class='fl'>" + p["f"] + "</div>"
        "<div class='pcs'>" + de_html +
        "<div class='pp'>R$ <span id='pc" + str(idx) + "'>" + brl(p["pc"]) + "</span></div></div>" +
        (("<div class='ops'>" + opts + "</div>") if tem_vs else "") +
        "<input type='hidden' id='en" + str(idx) + "' value='" + ean_pad + "'>"
        "<input type='hidden' id='nn" + str(idx) + "' value='" + nm_pad + "'>"
        "<button class='btnadd' onclick='addSac(" + str(idx) + ")'>ADICIONAR A SACOLA</button>"
        "</div></article>")

def render(lista):
    return "".join(card(p, i) for i, p in enumerate(lista))

@app.route("/")
def index():
    aba = request.args.get("aba", "").strip()
    if aba:
        lista = [p for p in CATALOGO if p["c"] == aba]
        c = "<a class='volta' href='/'>&#8592; Voltar</a><div class='grid'>" + render(lista) + "</div>"
    else:
        cats = ""
        for a in ABAS:
            if not any(x["c"] == a for x in CATALOGO):
                continue
            cats = cats + "<a class='cat' href='/?aba=" + urllib.parse.quote_plus(a) + "'>" + a + "</a>"
        c = "<h1>Drogaria Total Ituverava</h1><p class='sub'>Escolha uma categoria</p><div class='cats'>" + cats + "</div>"
    return HTML.replace("__CONTEUDO__", c)

